{
  "name": "beplus/beplus-manager",
  "description": "Deploy WordPress plugins and themes from GitHub with backups, rollback and webhook auto-deploy.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "ext-zip": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.0",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs --standard=WordPress src includes beplus-manager.php",
    "lint-fix": "phpcbf --standard=WordPress src includes beplus-manager.php"
  }
}
